# ---- Server ----
# Node environment: development | production
NODE_ENV=development

# API port
PORT=3000

# Rate limiting (requests per 60s window per IP)
RATE_LIMIT=20

# ---- Database ----
# sqlite | postgres
DB_TYPE=sqlite
# For sqlite:
DB_SQLITE_PATH=./local.sqlite
# For postgres (managed platforms like Render/Supabase may provide a single
# DATABASE_URL connection string instead of individual fields):
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=fullstacktest
# Use SSL for managed Postgres (e.g. RDS, Supabase). Auto-enabled when
# DATABASE_URL contains "render.com" or "rds.amazonaws.com".
DB_SSL=false

# Schema management.
#   - SQLite (dev): synchronize=true is fine.
#   - Postgres (prod): set DB_SYNCHRONIZE=false and run migrations.
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

# ---- Security ----
# Admin API key. Leave UNSET for local dev (auth guard becomes a no-op).
# In production set this and send it as `x-api-key` header or `Authorization: Bearer <key>`.
ADMIN_API_KEY=

# Comma-separated allowed CORS origins. Use * to allow any (not recommended in prod).
CORS_ORIGINS=http://localhost:5173
