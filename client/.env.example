# Frontend environment (Vite)
# Base URL for the API. Uses the Vite dev proxy ("/api") by default; for a
# deployed same-origin build leave this empty or set to the API origin.
VITE_API_URL=

# Optional admin API key. When set, it is sent as the `x-api-key` header on
# every request. Leave empty for local dev. In production this should be
# injected by a same-origin reverse proxy rather than shipped to browsers.
VITE_API_KEY=
